# Copy to .env.local and fill in. Never commit .env.local.

# Set either key, or neither. Without one the app still works: plan prose
# falls back to a deterministic writer and the UI says so.
#
# Preference order is OpenAI, then Gemini, then the fallback. Pin one with
# LLM_PROVIDER=openai | gemini | fallback.

# OpenAI, from platform.openai.com.
OPENAI_API_KEY=
# Optional model override. Defaults to gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini

# Gemini, from Google AI Studio.
GEMINI_API_KEY=
# Optional model override. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# LLM_PROVIDER=openai

# Web search provider for vendor research (M3).
SEARCH_API_KEY=

# Optional, for public-event inspiration only (M3).
# TICKETMASTER_API_KEY=

# Storage. Defaults to node:sqlite at .data/planpilot.db locally, and to an
# in-memory store on serverless hosts, where the filesystem is read-only.
# Force the in-memory driver with:
# PLANPILOT_STORE=memory
# Or point SQLite somewhere else:
# PLANPILOT_DB=./.data/planpilot.db
